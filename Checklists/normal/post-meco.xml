<PropertyList>

    <title>Post MECO</title>  

    <item>
      <name>External tank separation</name>
    </item>

    <item>
      <name>rotation rates</name>
      <value>NULL</value>
      <condition>
        <and>
	  <less-than>
	    <property>/fdm/jsbsim/velocities/q-rad_sec</property>
	    <value>0.000174</value>
	  </less-than>
	  <greater-than>
	    <property>/fdm/jsbsim/velocities/q-rad_sec</property>
	    <value>-0.000174</value>
	  </greater-than>
	  <less-than>
	    <property>/fdm/jsbsim/velocities/p-rad_sec</property>
	    <value>0.000174</value>
	  </less-than>
	  <greater-than>
	    <property>/fdm/jsbsim/velocities/p-rad_sec</property>
	    <value>-0.000174</value>
	  </greater-than>
	  <less-than>
	    <property>/fdm/jsbsim/velocities/r-rad_sec</property>
	    <value>0.000174</value>
	  </less-than>
	  <greater-than>
	    <property>/fdm/jsbsim/velocities/r-rad_sec</property>
	    <value>-0.000174</value>
	  </greater-than>	
        </and>
      </condition>
    </item>

    <item>
      <name>external tank</name>
      <value>SEPARATE</value>
      <condition>
        <equals>
	  <property>/controls/shuttle/ET-static-model</property>
	  <value>0</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>verify DAP switch to</name>
      <value>RCS</value>
      <condition>
        <or>
	  <greater-than>
	    <property>/fdm/jsbsim/systems/fcs/control-mode</property>
	    <value>19</value>
	  </greater-than>
	  <equals>
	    <property>/fdm/jsbsim/systems/fcs/control-mode</property>
	    <value>1</value>
	  </equals>
	  <equals>
	    <property>/fdm/jsbsim/systems/fcs/control-mode</property>
	    <value>2</value>
	  </equals>
        </or>
      </condition>
    </item>

    <item>
      <name>visually inspect ET</name>
      <value>REPORT</value>
    </item>

    
    <item>
      <name>Propellant dump</name>
    </item>

    <item>
      <name>verify LH2 prevalves</name>
      <value>OPEN</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/propellant/LH2-left-prevalve-status</property>
            <value>1</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/propellant/LH2-left-prevalve-status</property>
            <value>1</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/propellant/LH2-left-prevalve-status</property>
            <value>1</value>
          </equals>
        </and>
      </condition>     
    </item>

    <item>
      <name>verify LO2 prevalves</name>
      <value>OPEN</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/propellant/LO2-left-prevalve-status</property>
            <value>1</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/propellant/LO2-left-prevalve-status</property>
            <value>1</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/propellant/LO2-left-prevalve-status</property>
            <value>1</value>
          </equals>
        </and>
      </condition>     
    </item>

    <item>
      <name>verify helium system</name>
      <value>PRESSURIZED</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/mps/helium-system-pressurized</property>
          <value>1</value>
        </equals>
      </condition>     
    </item>

    <item>
      <name>set LO2 manifold pressurization valve</name>
      <value>OPEN</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/mps/LO2-manifold-valve-status</property>
          <value>1</value>
        </equals>
      </condition>     
    </item>

    <item>
      <name>set LH2 drain/fill valves</name>
      <value>OPEN</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/propellant/LH2-inboard-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/propellant/LH2-outboard-status</property>
            <value>1</value>
          </equals>
        </and>
      </condition>     
    </item>

    <item>
      <name>set propellant dump sequence to</name>
      <value>START</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/mps/propellant-dump-cmd</property>
          <value>1</value>
        </equals>
      </condition>     
    </item>

    <item>
      <name>wait for dump sequence</name>
      <value>COMPLETED</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/propulsion/tank[17]/contents-lbs</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/propulsion/tank[18]/contents-lbs</property>
            <value>0</value>
          </equals>
        </and>
      </condition>     
    </item>

    <item>
      <name>set LO2 manifold pressurization valve</name>
      <value>CLOSED</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/mps/LO2-manifold-valve-status</property>
          <value>0</value>
        </equals>
      </condition>     
    </item>


    <item>
      <name>Shut down APU</name>
    </item>

    <item>
      <name>water spray boiler controller power </name>
      <value>OFF</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/boiler-power-status</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/boiler-power-status</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/boiler-power-status</property>
            <value>0</value>
          </equals>
        </and>
      </condition> 
    </item>

    <item>
      <name>water spray boiler N2 supply</name>
      <value>CLOSED</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/boiler-N2-valve-status</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/boiler-N2-valve-status</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/boiler-N2-valve-status</property>
            <value>0</value>
          </equals>
        </and>
      </condition> 
    </item>
    
    <item>
      <name>APU operate switches</name>
      <value>STOP</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/apu-operate</property>
            <value>0</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-operate</property>
            <value>0</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-operate</property>
            <value>0</value>
          </equals>
        </and>
      </condition>     
    </item>

    <item>
      <name>APU fuel valves</name>
      <value>CLOSED</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/fuel-valve-status</property>
            <value>0</value>
          </equals>
    	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/fuel-valve-status</property>
            <value>0</value>
          </equals>
    	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/fuel-valve-status</property>
            <value>0</value>
          </equals>
        </and>
      </condition>     
    </item>
    
    <item>
      <name>APU controller power</name>
      <value>OFF</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/apu-controller-power</property>
            <value>0</value>
          </equals>
 	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-controller-power</property>
            <value>0</value>
          </equals>
 	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-controller-power</property>
            <value>0</value>
          </equals>
        </and>
      </condition>     
    </item>

    
    <item>
      <name>All hydraulic circulation pumps</name>
      <value>GPC</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/hyd-circ-pump-cmd</property>
            <value>0</value>
          </equals>
    	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/hyd-circ-pump-cmd</property>
            <value>0</value>
          </equals>
    	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/hyd-circ-pump-cmd</property>
            <value>0</value>
          </equals>
        </and>
      </condition>  
    </item>


    <item>
      <name>Plan orbital insertion</name>
    </item>

    <item>
      <name>verify orbital parameters</name>
      <value></value>
    </item>

    <item>
      <name>determine whether OMS burn is required</name>
      <value></value>
    </item>

    <item>
      <name>orient spacecraft for OMS burn</name>
      <value></value>
    </item>

</PropertyList>
