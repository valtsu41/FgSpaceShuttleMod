<PropertyList>

    <title>Pre de-orbit burn</title>  

    <item>
      <name>Verify de-orbit readiness</name>
    </item>

    <item>
      <name>Verify OMS gimbal</name>
      <value>FREE</value>
    </item>

    <item>
      <name>Verify payload bay doors</name>
      <value>CLOSED</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/mechanical/pb-door-right-pos</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/mechanical/pb-door-left-pos</property>
            <value>0</value>
          </equals>
	</and>
      </condition>
    </item>

    <item>
      <name>Verify ET umbilical door</name>
      <value>CLOSED</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/mechanical/et-door-left-pos</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/mechanical/et-door-right-pos</property>
            <value>1</value>
          </equals>
	</and>
      </condition>
    </item>

    <item>
      <name>Vent doors</name>
      <value>CLOSED</value>
      <condition>
	<equals>
	  <property>/fdm/jsbsim/systems/mechanical/vdoor-pos</property>
    	  <value>0.0</value>
	</equals>
      </condition>
    </item>

    <item>
      <name>MPS He A isolation valves</name>
      <value>OPEN</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/mps/engine/helium-isolation-valve-A-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/mps/engine[1]/helium-isolation-valve-A-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/mps/engine[2]/helium-isolation-valve-A-status</property>
            <value>1</value>
          </equals>
	</and>
      </condition>
    </item>

    <item>
      <name>MPS/TVC isolation valves</name>
      <value>OPEN</value>
      <condition>
	<and>
	  <equals>
	    <property>/fdm/jsbsim/systems/apu/apu/tvc-isolation-valve-status</property>
	    <value>1</value>
	  </equals>
	  <equals>
	    <property>/fdm/jsbsim/systems/apu/apu[1]/tvc-isolation-valve-status</property>
	    <value>1</value>
	  </equals>
	  <equals>
	    <property>/fdm/jsbsim/systems/apu/apu[2]/tvc-isolation-valve-status</property>
	    <value>1</value>
	  </equals>	
	</and>
      </condition>
    </item>
    

    <item>
      <name>Pre-start procedures for single APU</name>
    </item>

    <item>
      <name>APU controller power</name>
      <value>ON</value>
      <condition>
	<or>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/apu-controller-power</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-controller-power</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-controller-power</property>
            <value>1</value>
          </equals>
	</or>
      </condition>     
    </item>

    <item>
      <name>APU fuel valve</name>
      <value>OPEN</value>
      <condition>
	<or>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/fuel-valve-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/fuel-valve-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/fuel-valve-status</property>
            <value>1</value>
          </equals>
	</or>
      </condition>     
    </item>

    <item>
      <name>water spray boiler controller power </name>
      <value>ON</value>
      <condition>
	<or>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/boiler-power-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/boiler-power-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/boiler-power-status</property>
            <value>1</value>
          </equals>
	</or>
      </condition> 
    </item>

    <item>
      <name>water spray boiler N2 flow </name>
      <value>OPEN</value>
      <condition>
	<or>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/boiler-N2-valve-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/boiler-N2-valve-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/boiler-N2-valve-status</property>
            <value>1</value>
          </equals>
	</or>
      </condition> 
    </item>

    <item>
      <name>ready to start indicator</name>
      <value>READY</value>
      <condition>
	<or>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/apu-ready-to-start-sample-hold</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-ready-to-start-sample-hold</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-ready-to-start-sample-hold</property>
            <value>1</value>
          </equals>
	</or>
      </condition>     
    </item>

    <item>
      <name>Prepare burn</name>
    </item>

    <item>
      <name>maneuver to correct de-orbit burn attitude</name>
      <value></value>
    </item>



    <item>
      <name>Start a single APU</name>
    </item>



    <item>
      <name>operate switch</name>
      <value>START</value>
      <condition>
	<or>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/apu-operate</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-operate</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-operate</property>
            <value>1</value>
          </equals>
	</or>
      </condition>     
    </item>

    <item>
      <name>verify RPM </name>
      <value>> 58.000</value>
      <condition>
	<or>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu/apu-rpm</property>
            <value>58000</value>
          </greater-than>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-rpm</property>
            <value>58000</value>
          </greater-than>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-rpm</property>
            <value>58000</value>
          </greater-than>
	</or>
      </condition>     
    </item>

    <item>
      <name>hyd pump pressure</name>
      <value>HIGH</value>
      <condition>
	<or>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/hyd-pump-pressure-select</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/hyd-pump-pressure-select</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/hyd-pump-pressure-select</property>
            <value>1</value>
          </equals>
	</or>
      </condition>     
    </item>

    <item>
      <name>verify hydraulic pressure </name>
      <value>> 2400 psi</value>
      <condition>
	<or>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu/hyd-pressure-psia</property>
            <value>2400</value>
          </greater-than>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu[1]/hyd-pressure-psia</property>
            <value>2400</value>
          </greater-than>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu[2]/hyd-pressure-psia</property>
            <value>2400</value>
          </greater-than>
	</or>
      </condition>     
    </item>

    <item>
      <name>verify all airfoils move</name>
      <value>FREE</value>
    </item>

    <item>
      <name>set MPS/TVC isolation valves</name>
      <value>OPEN</value>
      <condition>
	<and>
	  <equals>
	    <property>/fdm/jsbsim/systems/apu/apu/tvc-isolation-valve-status</property>
	    <value>1</value>
	  </equals>
	  <equals>
	    <property>/fdm/jsbsim/systems/apu/apu[1]/tvc-isolation-valve-status</property>
	    <value>1</value>
	  </equals>
	  <equals>
	    <property>/fdm/jsbsim/systems/apu/apu[2]/tvc-isolation-valve-status</property>
	    <value>1</value>
	  </equals>	
	</and>
      </condition>
    </item>

    <item>
      <name>Execute de-orbit burn</name>
    </item>

    <item>
      <name>verify entry guidance target entered and guidance</name>
      <value>ACTIVE</value>
      <condition>
	<equals>
	  <property>/fdm/jsbsim/systems/entry_guidance/guidance-mode</property>
	  <value>1</value>
	</equals>
      </condition>
    </item>

    <item>
      <name>execute burn</name>
      <value></value>
    </item>

    <item>
      <name>verify ballistic impact point</name>
      <value>ON LANDING SITE</value>
    </item>
  
</PropertyList>
