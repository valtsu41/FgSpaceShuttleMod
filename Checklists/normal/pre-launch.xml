<PropertyList>

    <title>Pre-launch</title>  

    <item>
      <name>Electrical systems check</name>
    </item>

    <item>
      <name>T-8:00 essential buses to fuel cells</name>
      <value>CONNECTED</value>
    </item>

    <item>
      <name>T-8:00 verify SSME controllers</name>
      <value>POWERED</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/mps/engine/controller-power</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/mps/engine[1]/controller-power</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/mps/engine[2]/controller-power</property>
            <value>1</value>
          </equals>
	</and>
      </condition>   
    </item>

    <item>
      <name>APU and hydraulics startup</name>
    </item>

    <item>
      <name>T-6:15 water spray boiler N2 supply </name>
      <value>OPEN</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/boiler-N2-valve-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/boiler-N2-valve-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/boiler-N2-valve-status</property>
            <value>1</value>
          </equals>
	</and>
      </condition> 
    </item>

    <item>
      <name>T-6:15 water spray boiler controller power </name>
      <value>ON</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/boiler-power-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/boiler-power-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/boiler-power-status</property>
            <value>1</value>
          </equals>
	</and>
      </condition> 
    </item>

    <item>
      <name>T-6:15 APU controller power</name>
      <value>ON</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/apu-controller-power</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-controller-power</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-controller-power</property>
            <value>1</value>
          </equals>
	</and>
      </condition>     
    </item>

    <item>
      <name>T-6:15 APU fuel valve</name>
      <value>OPEN</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/fuel-valve-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/fuel-valve-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/fuel-valve-status</property>
            <value>1</value>
          </equals>
	</and>
      </condition>     
    </item>

    <item>
      <name>T-6:15 ready to start indicator</name>
      <value>READY</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/apu-ready-to-start-sample-hold</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-ready-to-start-sample-hold</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-ready-to-start-sample-hold</property>
            <value>1</value>
          </equals>
	</and>
      </condition>     
    </item>

    <item>
      <name>T-5:00 operate switch</name>
      <value>START</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/apu-operate</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-operate</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-operate</property>
            <value>1</value>
          </equals>
	</and>
      </condition>     
    </item>

    <item>
      <name>T-5:00 verify RPM</name>
      <value>> 58.000</value>
      <condition>
	<and>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu/apu-rpm</property>
            <value>58000</value>
          </greater-than>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-rpm</property>
            <value>58000</value>
          </greater-than>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-rpm</property>
            <value>58000</value>
          </greater-than>
	</and>
      </condition>     
    </item>

    <item>
      <name>T-5:00 hyd pump pressure</name>
      <value>NORM</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/hyd-pump-pressure-select</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/hyd-pump-pressure-select</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/hyd-pump-pressure-select</property>
            <value>1</value>
          </equals>
	</and>
      </condition>     
    </item>

    <item>
      <name>T-5:00 verify hydraulic pressure</name>
      <value>> 2400 psi</value>
      <condition>
	<and>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu/hyd-pressure-psia</property>
            <value>2400</value>
          </greater-than>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu[1]/hyd-pressure-psia</property>
            <value>2400</value>
          </greater-than>
          <greater-than>
            <property>/fdm/jsbsim/systems/apu/apu[2]/hyd-pressure-psia</property>
            <value>2400</value>
          </greater-than>
	</and>
      </condition>     
    </item>


    <item>
      <name>Final preparations</name>
    </item>

    <item>
      <name>T-3:25 verify main engine gimbal</name>
      <value>FREE</value>
    </item>

    <item>
      <name>T-2.00 start O2 flow, visor</name>
      <value>CLOSED</value>
    </item>
    
    <item>
      <name>T-0:07 main engine ignition sequence (shift+i)</name>
      <value>START </value>
      <condition>
	<and>
          <greater-than>
            <property>/controls/engines/engine/throttle</property>
            <value>0.0</value>
          </greater-than>
	</and>
      </condition>
    </item>

</PropertyList>
