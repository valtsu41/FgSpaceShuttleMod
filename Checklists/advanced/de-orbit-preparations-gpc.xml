<PropertyList>

  <title>Deorbit preparations DPS</title>

  <page>
    
    <item>
      <name>MEDs reconfiguration</name>
    </item>

    <item>
      <name>IDP/CRT 3 power</name>
      <value>ON</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/dps/idp-power-status[2]</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/electrical/display/C3-pwr-switch</property>
            <value>1</value>
          </equals>
        </and>
      </condition>
    </item>

    <item>
      <name>display GPC 2 on CRT 3</name>
      <value>GPC/CRT 23 EXEC</value>
    </item>

    <item>
      <name>verify GPC configuration</name>
    </item>

    
    <item>
      <name>verify GPC 3 mode (G2FD)</name>    
      <value>HALT</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/gpc3-mode-switch</property>
          <value>-1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>verify GPC 3 power</name>
      <value>ON</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/gpc3-power-switch</property>
          <value>1</value>
        </equals>
      </condition>
    </item>
    
    <item>
      <name>switch on GPC 3</name>    
      <value>RUN</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/gpc3-mode-switch</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>verify GPC 1 and 2 output</name>    
      <value>NORM</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/dps/gpc1-bus-switch</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/dps/gpc2-bus-switch</property>
            <value>0</value>
          </equals>
        </and>
      </condition>
    </item>

    <item>
      <name>verify GPC 3 and 5 output</name>    
      <value>NORM</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/dps/gpc3-bus-switch</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/dps/gpc5-bus-switch</property>
            <value>0</value>
          </equals>
        </and>
      </condition>
    </item>

    <item>
      <name>verify GPC 4 output</name>    
      <value>TERMINATE</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/gpc4-bus-switch</property>
          <value>-1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>verify GPC 1, 2 and 4 mode</name>    
      <value>RUN</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/dps/gpc1-mode-switch</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/dps/gpc2-mode-switch</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/dps/gpc4-mode-switch</property>
            <value>1</value>
          </equals>        
        </and>      
      </condition>
    </item>

    <item>
      <name>mode GPC 3 to</name>  
      <value>STANDBY</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/gpc3-mode-switch</property>
          <value>0</value>
        </equals>
      </condition>
    </item>
    
    <item>
      <name>verify GPC 5 mode</name>    
      <value>STANDBY</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/gpc5-mode-switch</property>
          <value>0</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>Transition GPC 1 and 2 to GNC OPS 3</name>
    </item>

    <item>
      <name>access GPC 1 memory (GNC 0)</name>
      <value>SPEC 0 PRO</value>
    </item>

    <item>
      <name>load MC 3 memory configuration</name>
      <value>ITEM 1+3 EXEC </value>
    </item>

    <item>
      <name>GPC 3 and 4 not yet in the redundant set</name>
      <value>ITEM 4+0+0 EXEC</value>
    </item>
    
    <item>
      <name>reassign GPC 3 and 4 strings</name>
      <value>ITEM 9+1+2 EXEC </value>
      <value>ITEM 14+2+0 EXEC </value>
    </item>

    
    <item>
      <name>GNC major mode</name>
      <value>OPS 301 PRO</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/major-mode</property>
          <value>301</value>
        </equals>
      </condition>
    </item>
    
    
    <item>
      <name>Transition BFS GPC to GNC OPS 3</name>
    </item>

    <item>
      <name>display BFS on CRT 3</name>
      <value>ON</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/bfs/display-switch</property>
          <value>1</value>
        </equals>
      </condition>      
    </item>
    
    <item>
      <name>BFS GNC major mode</name>
      <value>OPS 301 PRO</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/major-mode-bfs</property>
          <value>301</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>Transition GPC 1, 2, 3, 4 to GNC OPS 3</name>
    </item>

    <item>
      <name>display GPC 4 on a CRT</name>
      <value>GPC/CRT 41 EXEC</value>
    </item>

    <item>
      <name>load GPC 4 SM system software</name>
      <value>OPS 0 PRO</value>
    </item>


    <item>
      <name>GPC 4 output</name>    
      <value>NORM</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/gpc4-bus-switch</property>
          <value>0</value>
        </equals>
      </condition>
    </item>
    
    <item>
      <name>switch on GPC 3</name>  
      <value>RUN</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/gpc3-mode-switch</property>
          <value>1</value>
        </equals>
      </condition>
    </item>
    
    <item>
      <name>switch on GPC 5</name>    
      <value>RUN</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/gpc5-mode-switch</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>access GPC 1 memory (GNC 0)</name>
      <value>SPEC 0 PRO</value>
    </item>

    <item>
      <name>load MC 3 memory configuration</name>
      <value>ITEM 1+3 EXEC </value>
    </item>

    <item>
      <name>include GPC 3 and 4 in the redundant set</name>
      <value>ITEM 4+3+4 EXEC</value>
    </item>
    
    <item>
      <name>assign strings to GPC 3 and 4</name>
      <value>ITEM 9+3+4+1 EXEC </value>
      <value>ITEM 14+3+0 EXEC </value>
    </item>
    
    <item>
      <name>GNC major mode</name>
      <value>OPS 301 PRO</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/major-mode</property>
          <value>301</value>
        </equals>
      </condition>
    </item>

  </page>

  <page>
    
    <item>
      <name>BFS synchronization</name>
    </item>
    
    <item>
      <name>reset BFS to system software</name>
      <value>OPS 0 PRO</value>
    </item>

    
    <item>
      <name>restart BFS GNC major mode</name>
      <value>OPS 301 PRO</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/major-mode-bfs</property>
          <value>301</value>
        </equals>
      </condition>
    </item>

    
    <item>
      <name>display BFS on CRT 3</name>
      <value>OFF</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/bfs/display-switch</property>
          <value>0</value>
        </equals>
      </condition>      
    </item>

    <item>
      <name>verify GPC 3 on CRT 3</name>
      <value>CHECKED</value>
    </item>

    <item>
      <name>display BFS on CRT 3</name>
      <value>ON</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/dps/bfs/display-switch</property>
          <value>1</value>
        </equals>
      </condition>      
    </item>

    
    <item>
      <name>Deorbit burn solution</name>
    </item>

    <item>
      <name>trim load OMS both</name>
      <value>ITEM 6+0.4-5.7+5.7 EXEC</value>
    </item>

    <item>
      <name>trim load OMS single</name>
      <value>ITEM 6+0.4+5.2-5.2 EXEC</value>
    </item>

    <item>
      <name>load deorbit TGT and TIMER</name>
      <value>ITEM 22 EXEC</value>
      <value>ITEM 23 EXEC</value>
    </item>


    <item>
      <name>Star tracker deactivation</name>
    </item>


    <item>
      <name>load GNC S TRK/COAS CNTL program</name>
      <value>SPEC 22 PRO</value>
    </item>

    <item>
      <name>deactivate star tracking</name>
      <value>ITEM 3 EXEC</value>
      <value>ITEM 4 EXEC</value>
    </item>

    <!-- TO DO: we have a little bug in the cockpit. The -Y -Z power sitches
         are controlling door power, they should not -->
    <item>
      <name>star tracker -Y and -Z power</name>
      <value>OFF</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/mechanical/star-tracker-y-switch</property>
            <value>0</value>
          </equals>
          <equals>             
            <property>/fdm/jsbsim/systems/mechanical/star-tracker-z-switch</property>
            <value>0</value>
          </equals>
        </and>
      </condition>
    </item>

    <item>
      <name>verify Y door status</name>
      <value>OP</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/mechanical/star-tracker-door-y-pos</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>verify Z door status</name>
      <value>OP</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/mechanical/star-tracker-door-z-pos</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

   
    <item>
      <name>star tracker door control switches</name>
      <value>CLOSE</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/mechanical/star-tracker-sys1-switch</property>
            <value>-1</value>
          </equals>
          <equals>             
            <property>/fdm/jsbsim/systems/mechanical/star-tracker-sys2-switch</property>
            <value>-1</value>
          </equals>
        </and>
      </condition>
    </item>

    <item>
      <name>verify Y door status (8-24 sec)</name>
      <value>CL</value>
      <condition>
          <equals>
            <property>/fdm/jsbsim/systems/mechanical/star-tracker-door-y-pos</property>
            <value>0.0</value>
          </equals>
      </condition>
    </item>

    <item>
      <name>verify Z door status (8-24 sec)</name>
      <value>CL</value>
      <condition>
          <equals>
            <property>/fdm/jsbsim/systems/mechanical/star-tracker-door-z-pos</property>
            <value>0.0</value>
          </equals>
      </condition>
    </item>

     <item>
      <name>star tracker door control switches</name>
      <value>OFF</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/mechanical/star-tracker-sys1-switch</property>
            <value>0</value>
          </equals>
          <equals>             
            <property>/fdm/jsbsim/systems/mechanical/star-tracker-sys2-switch</property>
            <value>0</value>
          </equals>
        </and>
      </condition>
    </item>


    <item>
      <name>Forward deck configuration</name>
    </item>
    
    <item>
      <name>flash evaporator controller PRI B</name>
      <value>GPC</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/atcs/fes-controller-B-status</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    
    <item>
      <name>O2/N2 CNTRL VLV SYS 1</name>
      <value>OPEN</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/eclss/nitrogen/sys1-o2-n2-cntrl-valve-status</property>
          <value>1</value>
        </equals>
      </condition>
    </item>

    <item>
      <name>O2/N2 CNTRL VLV SYS 2</name>
      <value>CLOSE</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/eclss/nitrogen/sys2-o2-n2-cntrl-valve-status</property>
          <value>0</value>
        </equals>
      </condition>
    </item>

    
    <item>
      <name>IMU/IMU alignment</name>
    </item>

    <item>
      <name>load GNC IMU ALIGN program</name>
      <value>SPEC 21 PRO</value>
    </item>

    <item>
      <name>select reference for IMU/IMU alignment</name>
      <value>ITEM 14+1 EXEC</value>
    </item>

    <item>
      <name>check TYPE is TORQUE</name>
      <value>ITEM 15 EXEC</value>
    </item>

    <item>
      <name>select IMU 1</name>
      <value>ITEM 10 EXEC</value>
    </item>
    
    <item>
      <name>verify IMU 2 and 3 are unselected</name>
      <value>ITEM 11 and 12 no *</value>
    </item>
    
    <item>
      <name>align IMU 1</name>
      <value>ITEM 16 EXEC</value>
    </item>

    <item>
      <name>verify completion</name>
      <value>ITEM 16 EXEC no *</value>
    </item>

    <item>
      <name>HUD setup</name>
    </item>

    <item>
      <name>remove CDR and PLT covers</name>
      <value>REMOVED</value>
      <condition>
        <and>
          <equals>
            <property>/controls/shuttle/Hud-cover-cmd-show</property>
            <value>false</value>
          </equals>
          <equals>
            <property>/controls/shuttle/Hud-cover-plt-show</property>
            <value>false</value>
          </equals>          
        </and>
      </condition>
    </item>
    
  </page>
    
</PropertyList>

