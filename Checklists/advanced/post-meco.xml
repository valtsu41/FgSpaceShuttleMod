<PropertyList>

    <title>Post MECO advanced</title>  
   
  <page>
    <item>
      <name>If direct insertion</name>
    </item>

    <item>
      <name>OMS engine ARM/PRESS</name>
      <value>OFF</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/oms-hardware/engine-left-arm-cmd</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/oms-hardware/engine-right-arm-cmd</property>
            <value>0</value>
          </equals>
        </and>
      </condition>
    </item>

    <item>
      <name>Else OMS-1 burn</name>
    </item>
      
      
    <item>
      <name>visually inspect ET</name>
      <value>PHOTOS</value>
    </item>

    <item>
      <name>Propellant dump</name>
    </item>

    <item>
      <name>verify LH2 prevalves</name>
      <value>OPEN</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/propellant/LH2-left-prevalve-status</property>
            <value>1</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/propellant/LH2-left-prevalve-status</property>
            <value>1</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/propellant/LH2-left-prevalve-status</property>
            <value>1</value>
          </equals>
        </and>
      </condition>     
    </item>

    <item>
      <name>verify LO2 prevalves</name>
      <value>OPEN</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/propellant/LO2-left-prevalve-status</property>
            <value>1</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/propellant/LO2-left-prevalve-status</property>
            <value>1</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/propellant/LO2-left-prevalve-status</property>
            <value>1</value>
          </equals>
        </and>
      </condition>     
    </item>

    <item>
      <name>verify helium system</name>
      <value>PRESSURIZED</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/mps/helium-system-pressurized</property>
          <value>1</value>
        </equals>
      </condition>     
    </item>

    <item>
      <name>set LO2 manifold pressurization valve</name>
      <value>OPEN</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/mps/LO2-manifold-valve-status</property>
          <value>1</value>
        </equals>
      </condition>     
    </item>

    <item>
      <name>set LH2 drain/fill valves</name>
      <value>OPEN</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/propellant/LH2-inboard-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/propellant/LH2-outboard-status</property>
            <value>1</value>
          </equals>
        </and>
      </condition>     
    </item>

    <item>
      <name>set propellant dump sequence to</name>
      <value>START</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/mps/propellant-dump-cmd</property>
          <value>1</value>
        </equals>
      </condition>     
    </item>

    <item>
      <name>wait for dump sequence</name>
      <value>COMPLETED</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/mps/propellant-dump-density</property>
          <value>0</value>
        </equals>
      </condition>     
    </item>

    <item>
      <name>set LO2 manifold pressurization valve</name>
      <value>CLOSED</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/mps/LO2-manifold-valve-status</property>
          <value>0</value>
        </equals>
      </condition>     
    </item>
  </page>

  <page>
    <item>
      <name>Post burn status</name>
    </item>

    <item>
      <name>set MPS/TVC isolation valves (5 sec interval)</name>
      <value>CLOSED</value>
      <condition>
	<and>
	  <equals>
	    <property>/fdm/jsbsim/systems/apu/apu/tvc-isolation-valve-status</property>
	    <value>0</value>
	  </equals>
	  <equals>
	    <property>/fdm/jsbsim/systems/apu/apu[1]/tvc-isolation-valve-status</property>
	    <value>0</value>
	  </equals>
	  <equals>
	    <property>/fdm/jsbsim/systems/apu/apu[2]/tvc-isolation-valve-status</property>
	    <value>0</value>
	  </equals>	
	</and>
      </condition>
    </item>

    <item>
      <name>CDR/PLT flight controller power</name>
      <value>OFF</value>
      <condition>
	<and>
	  <equals>
            <property>/fdm/jsbsim/fcs/controller-power-cdr</property>
	    <value>0</value>
	  </equals>
	  <equals>
            <property>/fdm/jsbsim/fcs/controller-power-plt</property>
	    <value>0</value>
	  </equals>
	</and>
      </condition>      
    </item>
    
    <item>
      <name>DAP mode</name>
      <value>AUTO</value>
      <condition>
        <equals>
          <property>/fdm/jsbsim/systems/ap/orbital-dap-auto</property>
          <value>1</value>
        </equals>
      </condition>    
    </item>
    
    <item>
      <name>Shut down APU</name>
    </item>

    <item>
      <name>verify APU auto-shutdown</name>
      <value>ENABLE</value>
    </item>

    <item>
      <name>water spray boiler controller power </name>
      <value>OFF</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/boiler-power-status</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/boiler-power-status</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/boiler-power-status</property>
            <value>0</value>
          </equals>
        </and>
      </condition> 
    </item>

    <item>
      <name>water spray boiler N2 supply</name>
      <value>CLOSED</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/boiler-N2-valve-status</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/boiler-N2-valve-status</property>
            <value>0</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/boiler-N2-valve-status</property>
            <value>0</value>
          </equals>
        </and>
      </condition> 
    </item>
    
    <item>
      <name>APU operate switches (5 sec interval)</name>
      <value>STOP</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/apu-operate</property>
            <value>0</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-operate</property>
            <value>0</value>
          </equals>
	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-operate</property>
            <value>0</value>
          </equals>
        </and>
      </condition>     
    </item>

    <item>
      <name>APU fuel valves</name>
      <value>CLOSED</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/fuel-valve-status</property>
            <value>0</value>
          </equals>
    	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/fuel-valve-status</property>
            <value>0</value>
          </equals>
    	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/fuel-valve-status</property>
            <value>0</value>
          </equals>
        </and>
      </condition>     
    </item>
    
    <item>
      <name>verify APU shutdown with hydraulic pressure</name>
      <value>REDUCED</value>
      <condition>
	<and>
          <less-than>
            <property>/fdm/jsbsim/systems/apu/apu/hyd-pressure-psia</property>
            <value>2800</value>
          </less-than>
          <less-than>
            <property>/fdm/jsbsim/systems/apu/apu[1]/hyd-pressure-psia</property>
            <value>2800</value>
          </less-than>
          <less-than>
            <property>/fdm/jsbsim/systems/apu/apu[2]/hyd-pressure-psia</property>
            <value>2800</value>
          </less-than>
	</and>
      </condition>     
    </item>

    <item>
      <name>APU controller power</name>
      <value>OFF</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/apu-controller-power</property>
            <value>0</value>
          </equals>
 	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/apu-controller-power</property>
            <value>0</value>
          </equals>
 	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/apu-controller-power</property>
            <value>0</value>
          </equals>
        </and>
      </condition>     
    </item>

    <item>
      <name>hyd pump pressure</name>
      <value>NORM</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/hyd-pump-pressure-select</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/hyd-pump-pressure-select</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/hyd-pump-pressure-select</property>
            <value>1</value>
          </equals>
	</and>
      </condition>     
    </item>

    <item>
      <name>hydraulic circulation pumps</name>
      <value>GPC</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/hyd-circ-pump-cmd</property>
            <value>0</value>
          </equals>
    	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/hyd-circ-pump-cmd</property>
            <value>0</value>
          </equals>
    	  <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/hyd-circ-pump-cmd</property>
            <value>0</value>
          </equals>
        </and>
      </condition>  
    </item>
  </page>

  <page>
    <item>
      <name>Flash evaporator and heaters activation</name>
    </item>

    <item>
      <name>controller PRI A</name>
      <value>ON/GPC</value>
      <condition>
        <or>
          <equals>
            <property>/fdm/jsbsim/systems/atcs/fes-controller-A-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/atcs/fes-controller-A-status</property>
            <value>-1</value>
          </equals>
        </or>
      </condition>
    </item>

    <item>
      <name>heaters for water feedlines</name>
      <value>ON</value>
      <condition>
	<and>
          <equals>
            <property>/fdm/jsbsim/systems/atcs/fes-fdln-A-heater-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/atcs/fes-fdln-B-heater-status</property>
            <value>1</value>
          </equals>
        </and>
      </condition>
    </item>

    <item>
      <name>O2 tank 1 and 2 heaters</name>
      <value>B</value>
      <condition>
        <and>
          <greater-than-equals>
            <property>/fdm/jsbsim/systems/dummy/switch/o2-tank1b-heat</property>
            <value>1</value>
          </greater-than-equals>
          <greater-than-equals>
            <property>/fdm/jsbsim/systems/dummy/switch/o2-tank2b-heat</property>
            <value>1</value>
          </greater-than-equals>
        </and>
      </condition>
    </item>

    <item>
      <name>H2 tank 1 and 2 heaters</name>
      <value>B</value>
      <condition>
        <and>
          <greater-than-equals>
            <property>/fdm/jsbsim/systems/dummy/switch/h2-tank1b-heat</property>
            <value>1</value>
          </greater-than-equals>
          <greater-than-equals>
            <property>/fdm/jsbsim/systems/dummy/switch/h2-tank2b-heat</property>
            <value>1</value>
          </greater-than-equals>
        </and>
      </condition>
    </item>

    <item>
      <name>APU gas generator and fuel pump heaters</name>
      <value>A</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/gg-bed-heater-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/gg-bed-heater-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/gg-bed-heater-status</property>
            <value>1</value>
          </equals>
        </and>
      </condition>
    </item>

    <item>
      <name>APU lube oil line heaters</name>
      <value>A</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/lube-line-heater-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/lube-line-heater-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/lube-line-heater-status</property>
            <value>1</value>
          </equals>
        </and>
      </condition>
    </item>
    
    <item>
      <name>APU tank/fuel and line H20 heaters</name>
      <value>A</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/tank-heater-A-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu/tank-heater-B-status</property>
            <value>1</value>
          </equals>          
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/tank-heater-A-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[1]/tank-heater-B-status</property>
            <value>1</value>
          </equals>          
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/tank-heater-A-status</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/apu/apu[2]/tank-heater-B-status</property>
            <value>1</value>
          </equals>          
        </and>
      </condition>
    </item>
    
    <item>
      <name>AC bus sensors</name>
    </item>

    <item>
      <name>switch off AC BUS SNSR (1 sec)</name>
      <value>OFF</value>
      <condition>
        <or>
        <equals>
          <property>/fdm/jsbsim/systems/electrical/ac/ac-bus-snsr</property>
          <value>0</value>
        </equals>
        <equals>
          <property>/fdm/jsbsim/systems/electrical/ac[1]/ac-bus-snsr</property>
          <value>0</value>
        </equals>
        <equals>
          <property>/fdm/jsbsim/systems/electrical/ac[2]/ac-bus-snsr</property>
          <value>0</value>
        </equals>
        </or>
      </condition>
    </item>

    <item> 
      <name>set AC BUS SNSR</name>
      <value>AUTO TRIP</value>
      <condition>
        <and>
          <equals>
            <property>/fdm/jsbsim/systems/electrical/ac/ac-bus-snsr</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/electrical/ac[1]/ac-bus-snsr</property>
            <value>1</value>
          </equals>
          <equals>
            <property>/fdm/jsbsim/systems/electrical/ac[2]/ac-bus-snsr</property>
            <value>1</value>
          </equals>
        </and>
      </condition>
    </item>

    <item>
    <name>Major mode change</name>        
    </item>

    <item>
      <name>GNC major mode</name>
      <value>OPS 105 PRO</value>
      <condition>
      <equals>
          <property>/fdm/jsbsim/systems/dps/major-mode</property>
          <value>105</value>
      </equals>
      </condition>
    </item>
  </page>
</PropertyList>
