<PropertyList>
  
  <path>srb.ac</path>
  <nopreview/>
  
  <offsets>
    <heading-deg>-180</heading-deg>
    <roll-deg>-90</roll-deg>
  </offsets>  

  <effect>
    <inherits-from>Aircraft/SpaceShuttle/Models/Effects/srb-left</inherits-from>
    <object-name>srb.layer1</object-name>
  </effect>
  
  <model>
    <path>Aircraft/SpaceShuttle/Models/Effects/SRB_flame.xml</path>
    <condition>
      <equals>
        <property>controls/shuttle/SRB-static-model</property>
        <value>1</value>
      </equals>
    </condition>
    <offsets>
      <x-m>-18.5</x-m>
      <y-m>0</y-m>
      <z-m>0</z-m>
      <pitch-deg>180</pitch-deg>
      <roll-deg>0</roll-deg>
    </offsets>	
  </model>

  <model>
    <path>Aircraft/SpaceShuttle/Models/Effects/SRB_flame_near.xml</path>
    <condition>
      <and>
        <greater-than>
          <property>fdm/jsbsim/systems/various/srb-flame-alpha</property>
	  <value>0.0</value>
        </greater-than>
        <equals>
          <property>controls/shuttle/SRB-static-model</property>
          <value>1</value>
        </equals>
      </and>
    </condition>
    <offsets>
      <x-m>-22.5</x-m>
      <y-m>0</y-m>
      <z-m>0</z-m>
      <pitch-deg>180</pitch-deg>
      <roll-deg>0</roll-deg>
    </offsets>
  </model>

  <model>
    <path>Aircraft/SpaceShuttle/Models/Effects/SRB_smoke.xml</path>
    <condition>
      <equals>
        <property>controls/shuttle/SRB-static-model</property>
        <value>1</value>
      </equals>
    </condition>
    <offsets>
      <x-m>-180.5</x-m>
      <y-m>0.0</y-m>
      <z-m>0.0</z-m>
      <pitch-deg>0</pitch-deg>
      <roll-deg>0</roll-deg>
    </offsets>	
  </model>

</PropertyList>

