<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>
  
	<path>TDRS_demo.ac</path>
	<nopreview/>

	 <effect>
	    <inherits-from>Effects/space-combined</inherits-from>
	    <object-name>black_krinkle</object-name>
	    <object-name>shiny_panel</object-name>
	    <object-name>tex_01</object-name>
	    <object-name>tex_02</object-name>
	    <object-name>fixture_frame</object-name>
	 </effect>


	 <animation>
   		<enable-hot type="bool">false</enable-hot>
	 </animation>

	 
	<animation>	
	<type>rotate</type>
	<property>/controls/shuttle/TDRS-demo/payload-roll-deg</property>
	<axis>
   		<x>1</x>
   		<y>0</y>
   		<z>0</z>
  	</axis>
  	<center>
   		<x-m> 0</x-m>
   		<y-m> 0</y-m>
   		<z-m> 0</z-m>
  	</center>
	</animation>

	
	<animation>	
	<type>rotate</type>
	<property>/controls/shuttle/TDRS-demo/payload-yaw-deg</property>
	<axis>
   		<x>0</x>
   		<y>0</y>
   		<z>1</z>
  	</axis>
  	<center>
   		<x-m> 0</x-m>
   		<y-m> 0</y-m>
   		<z-m> 0</z-m>
  	</center>
	</animation>


	<animation>	
	<type>rotate</type>
	<property>/controls/shuttle/TDRS-demo/payload-pitch-deg</property>
	<axis>
   		<x>0</x>
   		<y>1</y>
   		<z>0</z>
  	</axis>
  	<center>
   		<x-m> 0</x-m>
   		<y-m> 0</y-m>
   		<z-m> 0</z-m>
  	</center>
	</animation>

	

	
	
</PropertyList>
